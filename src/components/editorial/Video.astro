---
// A clip in the writing: still + play button, opening the theatre overlay
// (the page includes <Theatre /> when a piece has a video).
import { parseVideo } from '../../lib/video';

interface Props {
  url?: string;
  caption?: string;
}

const { url, caption } = Astro.props;
const video = parseVideo(url);
---

{
  video && (
    <figure class="clip bleed bleed-wide">
      <button type="button" class="hit" data-video={video.embed} data-title={caption || 'Video'} aria-label={`Play ${caption || 'video'}`}>
        {video.thumbnail ? <img src={video.thumbnail} alt="" loading="lazy" decoding="async" /> : <span class="blank" />}
        <span class="play" aria-hidden="true">▶ Play</span>
      </button>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .clip {
    margin-block: 2.5lh;
  }

  .hit {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
    overflow: hidden;
  }

  .hit img,
  .blank {
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }

  .play {
    position: absolute;
    left: 1ch;
    bottom: 0.5lh;
    padding: 0.15lh 1ch;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.875em;
    text-transform: uppercase;
  }

  figcaption {
    max-width: calc(60ch + var(--gutter) * 2);
    margin: 0.75lh auto 0;
    padding-inline: var(--gutter);
    font-size: 0.8125em;
  }
</style>
