---
// A spoiler section, closed until the reader chooses to open it.
interface Props {
  label?: string;
}

const { label = 'Spoilers' } = Astro.props;
---

<details class="spoiler">
  <summary>{label || 'Spoilers'} · tap to reveal</summary>
  <div class="inner">
    <slot />
  </div>
</details>

<style>
  .spoiler {
    margin-block: 1.5lh;
    padding: 0.75lh 2ch;
    border: 1px dashed var(--muted);
  }

  summary {
    cursor: pointer;
    text-transform: uppercase;
    font-size: 0.875em;
    color: var(--accent, var(--ink));
  }

  .inner > :global(* + *) {
    margin-top: 1.25em;
  }

  .inner {
    margin-top: 1lh;
  }
</style>
