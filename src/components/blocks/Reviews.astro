---
import type { CollectionEntry } from 'astro:content';
import Films from '../Films.astro';
import { reviewItems } from '../../lib/reviews';
import { getLinks } from '../../lib/paths';
import { getSite } from '../../lib/content';
import type { Columns, FilmLayout } from '../../lib/options';

interface Props {
  reviews: CollectionEntry<'reviews'>[];
  count: number | null | undefined;
  layout: FilmLayout;
  columns: Columns;
}

const { reviews, count, layout, columns } = Astro.props;
const links = await getLinks();
const { sections } = await getSite();
const items = await reviewItems(reviews.slice(0, count || 4), { withExcerpt: layout === 'list' });
---

<Films items={items} layout={layout} columns={columns} />
<p class="more"><a href={links.reviews}>All {reviews.length} {sections.reviewsLabel.toLowerCase()} →</a></p>

<style>
  .more {
    margin-top: 1.5lh;
  }
</style>
