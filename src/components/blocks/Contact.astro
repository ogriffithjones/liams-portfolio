---
import { getSite } from '../../lib/content';

const { email, location, links } = await getSite();
---

<div class="contact reveal">
  {email && <p><a href={`mailto:${email}`}>{email}</a></p>}
  {location && <p class="muted">{location}</p>}
  {
    links.length > 0 && (
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.url} rel="me noopener" target="_blank">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2ch;
    margin: 1lh 0 0;
    padding: 0;
    list-style: none;
  }
</style>
