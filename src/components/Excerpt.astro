---
import type { Element } from '../lib/screenplay';

interface Props {
  elements: Element[];
  /** Copyright holder, shown in the watermark, notice and copied text */
  owner: string;
  title: string;
  year: number;
}

const { elements, owner, title, year } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const notice = `From "${title}" by ${owner}, © ${year}. All rights reserved. Not to be copied, reproduced or used for AI training. Read it at ${url}`;

// Faint repeating "© Name" watermark, so screenshots carry the credit. Used as
// a mask filled with the text colour, so it follows the site's theme.
const mark = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='300' height='170'><text x='150' y='95' fill='black' font-family='Courier New, monospace' font-size='15' text-anchor='middle' transform='rotate(-24 150 85)'>© ${owner.replace(/[<&>']/g, '')}</text></svg>`,
)}")`;

// Group side-by-side (dual) dialogue so it can sit in two columns
type Group = { dual: false; el: Element } | { dual: true; left: Element[]; right: Element[] };
const groups: Group[] = [];
for (const el of elements) {
  const last = groups.at(-1);
  if (!el.dual) groups.push({ dual: false, el });
  else if (last?.dual && !(el.dual === 'left' && last.right.length)) last[el.dual].push(el);
  else groups.push({ dual: true, left: el.dual === 'left' ? [el] : [], right: el.dual === 'right' ? [el] : [] });
}
---

<div class="protected" data-notice={notice} style={`--mark: ${mark}`}>
<div class="sp excerpt">
  {
    groups.map((g) =>
      g.dual ? (
        <div class="dual">
          {[g.left, g.right].map((col) => (
            <div class="sp">
              {col.map((el) => (
                <p class={`sp-${el.kind}`} set:html={el.html} />
              ))}
            </div>
          ))}
        </div>
      ) : (
        <p class={`sp-${g.el.kind}`} data-scene={g.el.scene} set:html={g.el.html} />
      ),
    )
  }
</div>
</div>
<footer class="rights muted">
  <p>© {year} {owner}. All rights reserved.</p>
  <p>
    This script may not be copied, reproduced, adapted or shared, in whole or in part, without the writer's written
    permission.
  </p>
  <p>
    No AI training. No consent is given for this script, or any part of it, to be used to train, fine-tune or evaluate
    artificial intelligence or machine learning models, or for text and data mining of any kind. This reservation of
    rights is made under Article 4(3) of EU Directive 2019/790 and applies wherever such a reservation is recognised.
  </p>
</footer>
<p class="print-note">This script excerpt isn't available to print. Read it at {url}</p>

<script>
  // Deterrents only: the text stays in the page for search engines and
  // screen readers, and nothing on the web can block screenshots.
  const areas = [...document.querySelectorAll<HTMLElement>('.protected')];
  const inside = (node: Node | null) => !!node && areas.some((a) => a.contains(node));

  document.addEventListener('copy', (event) => {
    const selection = document.getSelection();
    const hit = areas.find((a) => selection && !selection.isCollapsed && selection.containsNode(a, true));
    if (!hit && !inside(event.target as Node)) return;
    event.preventDefault();
    event.clipboardData?.setData('text/plain', (hit ?? areas[0])!.dataset.notice!);
  });
  for (const type of ['cut', 'contextmenu', 'dragstart', 'selectstart']) {
    document.addEventListener(type, (event) => inside(event.target as Node) && event.preventDefault());
  }
</script>

<style>
  .protected {
    position: relative;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .protected::after {
    content: '';
    position: absolute;
    inset: -1lh -2ch;
    background: var(--ink);
    opacity: 0.07;
    -webkit-mask-image: var(--mark);
    mask-image: var(--mark);
    pointer-events: none;
  }

  .rights {
    margin-top: 3lh;
    padding-top: 1lh;
    border-top: 1px solid var(--line);
    font-size: 0.8125em;
  }

  .rights p + p {
    margin-top: 0.5lh;
  }

  .print-note {
    display: none;
  }

  @media print {
    .protected,
    .rights {
      display: none;
    }

    .print-note {
      display: block;
    }
  }

  /* Keep line breaks from the script within a paragraph */
  .excerpt :global(p) {
    white-space: pre-line;
  }

  .excerpt :global(.sp-shot) {
    text-transform: uppercase;
  }

  /* Part of a longer script: CONTINUED: at the top, (CONTINUED) at the bottom */
  .excerpt :global(.sp-continued-top),
  .excerpt :global(.sp-continued-bottom) {
    color: var(--muted);
    text-transform: uppercase;
  }

  .excerpt :global(.sp-continued-bottom) {
    text-align: right;
  }

  /* Marks scenes left out between chosen ones */
  .excerpt :global(.sp-gap) {
    margin-block: 2lh;
    text-align: center;
    color: var(--muted);
    letter-spacing: 0.3em;
  }

  .dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2ch;
  }

  .dual :global(.sp-character) {
    margin-left: 25%;
  }

  .dual :global(.sp-parenthetical) {
    margin-left: 12%;
    max-width: none;
  }

  .dual :global(.sp-dialogue) {
    margin-left: 0;
    max-width: none;
  }
</style>
