---
// A note / opinion piece, laid out like a magazine long-read.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Theatre from '../Theatre.astro';
import { formatDate, getSite, isoDate } from '../../lib/content';
import { getLinks } from '../../lib/paths';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { data } = note;
const { Content } = await render(note);
const site = await getSite();
const links = await getLinks();

const author = data.byline?.trim() || site.name;
// About 230 words a minute, ignoring editor markup
const words = (note.body ?? '').replace(/\{%[\s\S]*?%\}/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
const hasVideo = /\{%\s*video\b/.test(note.body ?? '');
const film = data.filmBox;
const facts = [
  ['Director', film.director],
  ['Runtime', film.runtime],
  ['Country', film.country],
  ['Where to watch', film.where],
].filter(([, v]) => v);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.standfirst || data.summary,
  datePublished: isoDate(data.date),
  author: { '@type': 'Person', name: author, url: Astro.site?.href },
  about: data.film ? { '@type': 'Movie', name: data.film, director: film.director || undefined } : undefined,
  wordCount: words,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={data.title} description={data.summary} image={data.lead.image} type="article" jsonLd={jsonLd} back>
  <article class="page piece">
    <header class="head">
      <p class="kicker"><a href={links.notes}>{site.sections.notesLabel}</a>{data.film && <> · {data.film}</>}</p>
      <h1>{data.title}</h1>
      {data.standfirst && <p class="standfirst">{data.standfirst}</p>}
      <p class="byline">
        By {author} · <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time> · {minutes} min read
      </p>
    </header>

    {
      data.lead.image && (
        <figure class="lead bleed bleed-wide">
          <Image
            src={data.lead.image}
            alt={data.lead.alt ?? ''}
            widths={[640, 960, 1280, 1920, 2560]}
            sizes="(min-width: 80rem) 76rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          {(data.lead.caption || data.lead.credit) && (
            <figcaption>
              {data.lead.caption && <span>{data.lead.caption}</span>}
              {data.lead.credit && <span class="credit">{data.lead.credit}</span>}
            </figcaption>
          )}
        </figure>
      )
    }

    {data.spoilers && <p class="warning">Spoiler warning: this piece discusses the plot, including the ending.</p>}

    <div class:list={['prose', data.dropCap && 'drop-cap']}>
      <Content />
    </div>

    {
      film.show && data.film && (
        <aside class="film" aria-label="Film details">
          <p class="film-title">{data.film}</p>
          {facts.length > 0 && (
            <dl>
              {facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}
          {film.link && (
            <p>
              <a href={film.link} rel="noopener" target="_blank">
                More on this film →
              </a>
            </p>
          )}
        </aside>
      )
    }
  </article>

  {hasVideo && <Theatre />}
</Base>

<style>
  .head {
    padding-block: 3lh 2lh;
  }

  .kicker {
    font-size: 0.8125em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent, var(--muted));
  }

  .kicker a {
    color: inherit;
    text-decoration: none;
  }

  h1 {
    margin-top: 0.75lh;
    font-size: clamp(1.6em, 4vw, 2.2em);
    line-height: 1.15;
    font-weight: 700;
    text-wrap: balance;
  }

  .standfirst {
    margin-top: 1lh;
    font-size: 1.15em;
    line-height: 1.45;
    font-style: italic;
    text-wrap: pretty;
  }

  .byline {
    margin-top: 1.25lh;
    padding-top: 0.75lh;
    border-top: 1px solid var(--line);
    font-size: 0.8125em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lead {
    margin-block: 0 2.5lh;
  }

  .lead :global(img) {
    width: 100%;
    height: auto;
  }

  .lead figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25lh 2ch;
    max-width: calc(60ch + var(--gutter) * 2);
    margin: 0.75lh auto 0;
    padding-inline: var(--gutter);
    font-size: 0.8125em;
    line-height: 1.45;
  }

  .credit {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .warning {
    margin-bottom: 2lh;
    padding: 0.75lh 2ch;
    border: 1px dashed var(--muted);
    font-size: 0.875em;
    text-transform: uppercase;
  }

  /* Large first letter, set into the opening paragraph */
  .drop-cap > :global(article > p:first-of-type)::first-letter {
    float: left;
    margin: 0.05em 0.6ch 0 0;
    font-size: 3.4em;
    line-height: 0.85;
    font-weight: 700;
    color: var(--accent, var(--ink));
  }

  .film {
    margin-top: 3lh;
    padding: 1.25lh 2ch;
    border: 1px solid var(--line);
    font-size: 0.9375em;
  }

  .film-title {
    font-weight: 700;
    text-transform: uppercase;
  }

  .film dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25lh 3ch;
    margin: 1lh 0 0;
  }

  .film dl div {
    display: contents;
  }

  .film dt {
    color: var(--muted);
  }

  .film dd {
    margin: 0;
  }

  .film p + p,
  .film dl + p {
    margin-top: 1lh;
  }
</style>
