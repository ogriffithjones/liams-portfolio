---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getSite, isoDate } from '../../lib/content';

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { data } = note;
const { Content } = await render(note);
const site = await getSite();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.summary,
  datePublished: isoDate(data.date),
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  about: data.film ? { '@type': 'Movie', name: data.film } : undefined,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={data.title} description={data.summary} type="article" jsonLd={jsonLd} back>
  <article class="page">
    <header class="sp head">
      <h1 class="sp-scene">{data.title}</h1>
      <p class="muted">
        {data.film && <>{data.film} · </>}
        <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .head {
    padding-block: 2lh;
  }

  .head p {
    margin-top: 0;
  }
</style>
