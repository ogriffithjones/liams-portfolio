---
// The writing page: reviews and opinion pieces with search, filters and
// sorting. Only built when Writing is switched on and there's something to show.
import Base from '../../layouts/Base.astro';
import Films from '../../components/Films.astro';
import { getSite, getWriting, stars } from '../../lib/content';
import { writingItems } from '../../lib/writing';

const site = await getSite();
const pieces = await getWriting();
const items = await writingItems(pieces, { withExcerpt: true });
const years = pieces.flatMap((p) => (p.data.kind.discriminant === 'review' && p.data.kind.value.year ? [p.data.kind.value.year] : []));
const bothKinds = new Set(pieces.map((p) => p.data.kind.discriminant)).size > 1;
const label = site.sections.writingLabel;

const decades = [...new Set(years.map((y) => Math.floor(y / 10) * 10))].sort(
  (a, b) => Number(b) - Number(a),
);
const tags = [...new Set(pieces.flatMap((p) => p.data.tags))].sort((a, b) => a.localeCompare(b));
const ratingSteps = [5, 4.5, 4, 3.5, 3, 2.5, 2, 1.5, 1];
---

<Base title={label} description={`Film reviews and writing by ${site.name}. ${pieces.length} pieces, searchable by title, rating, decade and tag.`} back>
  <section class="page sp head">
    <h1 class="sp-scene">{label}</h1>
    <p class="muted"><span id="count">{pieces.length}</span> of {pieces.length}</p>
  </section>

  <form class="page filters" id="filters" role="search" hidden>
    <label class="search">
      <span class="visually-hidden">Search writing</span>
      <input type="search" name="q" placeholder="Search titles, directors, tags…" autocomplete="off" />
    </label>
    {
      bothKinds && (
        <label>
          <span class="muted">Type</span>
          <select name="kind">
            <option value="">All</option>
            <option value="review">Reviews</option>
            <option value="opinion">Opinion</option>
          </select>
        </label>
      )
    }
    <label>
      <span class="muted">Rating</span>
      <select name="rating">
        <option value="">Any</option>
        {ratingSteps.map((r) => <option value={r}>{stars(r)}{r < 5 ? '+' : ''}</option>)}
      </select>
    </label>
    {
      decades.length > 1 && (
        <label>
          <span class="muted">Decade</span>
          <select name="decade">
            <option value="">Any</option>
            {decades.map((d) => <option value={d}>{d}s</option>)}
          </select>
        </label>
      )
    }
    {
      tags.length > 0 && (
        <label>
          <span class="muted">Tag</span>
          <select name="tag">
            <option value="">Any</option>
            {tags.map((t) => <option value={t.toLowerCase()}>{t}</option>)}
          </select>
        </label>
      )
    }
    <label>
      <span class="muted">Sort</span>
      <select name="sort">
        <option value="watched">Recently watched</option>
        <option value="rating">Highest rated</option>
        <option value="year">Newest films</option>
        <option value="title">Title A–Z</option>
      </select>
    </label>
    <label class="check">
      <input type="checkbox" name="liked" value="1" />
      <span>Liked ♥</span>
    </label>
  </form>

  <div class="page results">
    <Films items={items} layout="list" id="writing" />
    <p class="empty muted" id="empty" hidden>Nothing matches. <button type="button" id="reset">Clear filters</button></p>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('#filters')!;
  const list = document.querySelector<HTMLElement>('#writing')!;
  const items = [...list.querySelectorAll<HTMLElement>(':scope > li')];
  const count = document.querySelector('#count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;

  const sorters: Record<string, (a: DOMStringMap, b: DOMStringMap) => number> = {
    watched: (a, b) => b.watched!.localeCompare(a.watched!),
    rating: (a, b) => Number(b.rating) - Number(a.rating) || b.watched!.localeCompare(a.watched!),
    year: (a, b) => Number(b.year || 0) - Number(a.year || 0),
    title: (a, b) => a.title!.localeCompare(b.title!),
  };

  // Restore filters from the address bar, so filtered views can be shared
  const params = new URLSearchParams(location.search);
  for (const [name, value] of params) {
    const field = form.elements.namedItem(name);
    if (field instanceof HTMLInputElement && field.type === 'checkbox') field.checked = value === '1';
    else if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) field.value = value;
  }

  function apply() {
    const f = new FormData(form);
    const q = String(f.get('q') ?? '').trim().toLowerCase();
    const words = q.split(/\s+/).filter(Boolean);
    const rating = Number(f.get('rating') || 0);
    const decade = String(f.get('decade') ?? '');
    const kind = String(f.get('kind') ?? '');
    const tag = String(f.get('tag') ?? '');
    const liked = f.get('liked') === '1';
    const sort = String(f.get('sort') || 'watched');

    let shown = 0;
    for (const li of items) {
      const d = li.dataset;
      const match =
        words.every((w) => d.search!.includes(w)) &&
        Number(d.rating) >= rating &&
        (!decade || d.decade === decade) &&
        (!kind || d.kind === kind) &&
        (!tag || d.tags!.includes(`|${tag}|`)) &&
        (!liked || d.liked === '1');
      li.hidden = !match;
      if (match) shown++;
    }
    items.sort((a, b) => sorters[sort]!(a.dataset, b.dataset)).forEach((li) => list.append(li));
    count.textContent = String(shown);
    empty.hidden = shown > 0;

    const next = new URLSearchParams();
    for (const [k, v] of f) if (v && !(k === 'sort' && v === 'watched')) next.set(k, String(v));
    history.replaceState(null, '', next.size ? `?${next}` : location.pathname);
  }

  form.hidden = false;
  form.addEventListener('input', apply);
  form.addEventListener('submit', (e) => e.preventDefault());
  document.querySelector('#reset')!.addEventListener('click', () => {
    form.reset();
    apply();
  });
  apply();
</script>

<style>
  .head {
    padding-block: 2lh 1lh;
  }

  .head .muted {
    margin-top: 0;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1lh 2ch;
    align-items: end;
    margin-bottom: 2lh;
    font-size: 0.875em;
  }

  .filters label {
    display: grid;
    gap: 0.25lh;
  }

  .filters .search {
    flex: 1 1 100%;
  }

  .filters .check {
    display: flex;
    gap: 1ch;
    align-items: center;
    padding-bottom: 0.4lh;
  }

  input[type='search'],
  select {
    font: inherit;
    color: inherit;
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    padding: 0.35lh 0;
    transition: border-color 0.2s var(--ease);
  }

  input[type='search'] {
    width: 100%;
    font-size: 1.125em;
  }

  input[type='search']:focus,
  select:focus {
    outline: none;
    border-bottom-color: var(--ink);
  }

  select {
    padding-right: 1ch;
    cursor: pointer;
  }

  input[type='checkbox'] {
    accent-color: var(--ink);
  }

  .results :global(li[hidden]) {
    display: none;
  }

  .empty button {
    font: inherit;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
</style>
