---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Theatre from '../Theatre.astro';
import { excerpt, getSite, isoDate } from '../../lib/content';
import { reviewMeta, reviewPoster } from '../../lib/reviews';
import { getLinks } from '../../lib/paths';

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { data } = review;
const { Content } = await render(review);
const hasVideo = /\{%\s*video\b/.test(review.body ?? '');
const site = await getSite();
const links = await getLinks();
const poster = await reviewPoster(review);
const label = `${data.title}${data.year ? ` (${data.year})` : ''}`;
const description = excerpt(review.body, 155) || `${site.name} on ${label}.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: `${label} review`,
  datePublished: isoDate(data.watched),
  author: { '@type': 'Person', name: site.name, url: Astro.site?.href },
  itemReviewed: {
    '@type': 'Movie',
    name: data.title,
    dateCreated: data.year ? String(data.year) : undefined,
    director: data.director ? { '@type': 'Person', name: data.director } : undefined,
  },
  reviewRating: data.rating ? { '@type': 'Rating', ratingValue: data.rating, bestRating: 5, worstRating: 0.5 } : undefined,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={`${label} review`} description={description} image={poster && !('srcset' in poster) ? poster : null} type="article" jsonLd={jsonLd} back>
  <article class="page">
    <header class:list={['head', poster && 'with-poster']}>
      {
        poster && (
          <div class="poster">
            {'srcset' in poster ? (
              <img src={poster.src} srcset={poster.srcset} sizes="12rem" alt={`Poster for ${data.title}`} width="342" height="513" />
            ) : (
              <Image src={poster} alt={`Poster for ${data.title}`} widths={[185, 342, 500]} sizes="12rem" />
            )}
          </div>
        )
      }
      <div class="sp">
        <h1 class="sp-scene">{label}</h1>
        {data.director && <p class="muted">Directed by {data.director}</p>}
        <p>{reviewMeta(review)}</p>
        {data.tags.length > 0 && <p class="muted">{data.tags.join(', ')}</p>}
        {data.letterboxd && <p><a href={data.letterboxd} rel="noopener" target="_blank">On Letterboxd</a></p>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="more"><a href={links.reviews}>← All {site.sections.reviewsLabel.toLowerCase()}</a></p>
  </article>

  {hasVideo && <Theatre />}
</Base>

<style>
  .head {
    padding-block: 2lh;
  }

  .with-poster {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 3ch;
    align-items: start;
  }

  .head .sp > * + * {
    margin-top: 0.5lh;
  }

  .poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--line);
  }

  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .more {
    margin-top: 3lh;
  }

  @media (max-width: 30rem) {
    .with-poster {
      grid-template-columns: 6rem 1fr;
      gap: 2ch;
    }
  }
</style>
