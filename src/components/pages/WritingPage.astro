---
// One piece of writing. Reviews get a poster-and-rating header; opinion
// pieces get a magazine long-read header, lead image and film details box.
// Both share the editorial toolkit in the text.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Theatre from '../Theatre.astro';
import { excerpt, formatDate, getSite, isoDate } from '../../lib/content';
import { getLinks } from '../../lib/paths';
import { kindLabel, pieceMeta, piecePoster, readingMinutes } from '../../lib/writing';

interface Props {
  piece: CollectionEntry<'writing'>;
}

const { piece } = Astro.props;
const { data } = piece;
const { Content } = await render(piece);
const site = await getSite();
const links = await getLinks();

const review = data.kind.discriminant === 'review' ? data.kind.value : null;
const opinion = data.kind.discriminant === 'opinion' ? data.kind.value : null;
const author = data.byline?.trim() || site.name;
const minutes = readingMinutes(piece.body);
const hasVideo = /\{%\s*video\b/.test(piece.body ?? '');
const poster = review ? await piecePoster(piece) : null;
const heading = review?.year ? `${data.title} (${review.year})` : data.title;
const description = data.summary?.trim() || opinion?.standfirst || excerpt(piece.body, 155) || `${site.name} on ${data.title}.`;

const film = opinion?.filmBox;
const facts = film
  ? [
      ['Director', film.director],
      ['Runtime', film.runtime],
      ['Country', film.country],
      ['Where to watch', film.where],
    ].filter(([, v]) => v)
  : [];

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = review
  ? {
      '@context': 'https://schema.org',
      '@type': 'Review',
      name: `${heading} review`,
      datePublished: isoDate(data.date),
      author: { '@type': 'Person', name: author, url: Astro.site?.href },
      itemReviewed: {
        '@type': 'Movie',
        name: data.title,
        dateCreated: review.year ? String(review.year) : undefined,
        director: review.director ? { '@type': 'Person', name: review.director } : undefined,
      },
      reviewRating: review.rating ? { '@type': 'Rating', ratingValue: review.rating, bestRating: 5, worstRating: 0.5 } : undefined,
      url,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: data.title,
      description,
      datePublished: isoDate(data.date),
      author: { '@type': 'Person', name: author, url: Astro.site?.href },
      about: opinion?.film ? { '@type': 'Movie', name: opinion.film, director: film?.director || undefined } : undefined,
      url,
    };
const shareImage = review ? (poster && !('srcset' in poster) ? poster : null) : (opinion?.lead.image ?? null);
---

<Base title={review ? `${heading} review` : data.title} description={description} image={shareImage} type="article" jsonLd={jsonLd} back>
  <article class="page piece">
    {
      review ? (
        <header class:list={['head', 'review-head', poster && 'with-poster']}>
          {poster && (
            <div class="poster">
              {'srcset' in poster ? (
                <img src={poster.src} srcset={poster.srcset} sizes="12rem" alt={`Poster for ${data.title}`} width="342" height="513" />
              ) : (
                <Image src={poster} alt={`Poster for ${data.title}`} widths={[185, 342, 500]} sizes="12rem" />
              )}
            </div>
          )}
          <div>
            <p class="kicker">
              <a href={links.writing}>{kindLabel.review}</a>
            </p>
            <h1>{heading}</h1>
            {review.director && <p class="muted">Directed by {review.director}</p>}
            <p class="meta">{pieceMeta(piece)}</p>
            {data.tags.length > 0 && <p class="muted">{data.tags.join(', ')}</p>}
            {review.letterboxd && (
              <p>
                <a href={review.letterboxd} rel="noopener" target="_blank">
                  On Letterboxd
                </a>
              </p>
            )}
          </div>
        </header>
      ) : (
        <header class="head">
          <p class="kicker">
            <a href={links.writing}>{kindLabel.opinion}</a>
            {opinion?.film && <> · {opinion.film}</>}
          </p>
          <h1>{data.title}</h1>
          {opinion?.standfirst && <p class="standfirst">{opinion.standfirst}</p>}
          <p class="byline">
            By {author} · <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time> · {minutes} min read
          </p>
        </header>
      )
    }

    {
      opinion?.lead.image && (
        <figure class="lead bleed bleed-wide">
          <Image
            src={opinion.lead.image}
            alt={opinion.lead.alt ?? ''}
            widths={[640, 960, 1280, 1920, 2560]}
            sizes="(min-width: 80rem) 76rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
          {(opinion.lead.caption || opinion.lead.credit) && (
            <figcaption>
              {opinion.lead.caption && <span>{opinion.lead.caption}</span>}
              {opinion.lead.credit && <span class="credit">{opinion.lead.credit}</span>}
            </figcaption>
          )}
        </figure>
      )
    }

    {data.spoilers && <p class="warning">Spoiler warning: this piece discusses the plot, including the ending.</p>}

    <div class:list={['prose', data.dropCap && 'drop-cap']}>
      <Content />
    </div>

    {
      film?.show && opinion?.film && (
        <aside class="film" aria-label="Film details">
          <p class="film-title">{opinion.film}</p>
          {facts.length > 0 && (
            <dl>
              {facts.map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}
          {film.link && (
            <p>
              <a href={film.link} rel="noopener" target="_blank">
                More on this film →
              </a>
            </p>
          )}
        </aside>
      )
    }

    <p class="more"><a href={links.writing}>← All {site.sections.writingLabel.toLowerCase()}</a></p>
  </article>

  {hasVideo && <Theatre />}
</Base>

<style>
  .head {
    padding-block: 3lh 2lh;
  }

  .kicker {
    font-size: 0.8125em;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent, var(--muted));
  }

  .kicker a {
    color: inherit;
    text-decoration: none;
  }

  h1 {
    margin-top: 0.75lh;
    font-size: clamp(1.6em, 4vw, 2.2em);
    line-height: 1.15;
    font-weight: 700;
    text-wrap: balance;
  }

  .standfirst {
    margin-top: 1lh;
    font-size: 1.15em;
    line-height: 1.45;
    font-style: italic;
    text-wrap: pretty;
  }

  .byline {
    margin-top: 1.25lh;
    padding-top: 0.75lh;
    border-top: 1px solid var(--line);
    font-size: 0.8125em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lead {
    margin-block: 0 2.5lh;
  }

  .lead :global(img) {
    width: 100%;
    height: auto;
  }

  .lead figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25lh 2ch;
    max-width: calc(60ch + var(--gutter) * 2);
    margin: 0.75lh auto 0;
    padding-inline: var(--gutter);
    font-size: 0.8125em;
    line-height: 1.45;
  }

  .credit {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .warning {
    margin-bottom: 2lh;
    padding: 0.75lh 2ch;
    border: 1px dashed var(--muted);
    font-size: 0.875em;
    text-transform: uppercase;
  }

  /* Large first letter, set into the opening paragraph */
  .drop-cap > :global(article > p:first-of-type)::first-letter {
    float: left;
    margin: 0.05em 0.6ch 0 0;
    font-size: 3.4em;
    line-height: 0.85;
    font-weight: 700;
    color: var(--accent, var(--ink));
  }

  .film {
    margin-top: 3lh;
    padding: 1.25lh 2ch;
    border: 1px solid var(--line);
    font-size: 0.9375em;
  }

  .film-title {
    font-weight: 700;
    text-transform: uppercase;
  }

  .film dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25lh 3ch;
    margin: 1lh 0 0;
  }

  .film dl div {
    display: contents;
  }

  .film dt {
    color: var(--muted);
  }

  .film dd {
    margin: 0;
  }

  .film p + p,
  .film dl + p {
    margin-top: 1lh;
  }

  /* Reviews: poster beside the title */
  .review-head {
    padding-block: 2lh;
  }

  .with-poster {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 3ch;
    align-items: start;
  }

  .review-head h1 {
    margin-top: 0.5lh;
    font-size: 1.4em;
  }

  .review-head p + p,
  .review-head h1 + p {
    margin-top: 0.5lh;
  }

  .poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--line);
  }

  .poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 30rem) {
    .with-poster {
      grid-template-columns: 6rem 1fr;
      gap: 2ch;
    }
  }

  .more {
    margin-top: 3lh;
  }
</style>
