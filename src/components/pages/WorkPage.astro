---
import type { CollectionEntry } from 'astro:content';
// A page for each project that has a script excerpt.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Excerpt from '../../components/Excerpt.astro';
import Theatre from '../../components/Theatre.astro';
import { getSite } from '../../lib/content';
import { loadExcerpt, scriptLabel } from '../../lib/screenplay';
import { parseVideo } from '../../lib/video';

interface Props {
  project: CollectionEntry<'work'>;
}

const { project } = Astro.props;
const { data } = project;
const site = await getSite();
const elements = await loadExcerpt(data);
const label = scriptLabel(data.excerptLabel, elements);
const video = parseVideo(data.video);
const thumbnail = data.image ? undefined : video?.thumbnail;

// The full script stays private unless Liam chooses to link it: by default
// visitors are invited to email and ask for it.
const request = site.email
  ? `mailto:${site.email}?subject=${encodeURIComponent(`Script request: ${data.title}`)}`
  : null;
const fullScript =
  data.fullScript === 'link' && data.link
    ? { href: data.link, label: 'Read the full script →', external: true }
    : data.fullScript === 'request' && request
      ? { href: request, label: 'Request the full script →', external: false }
      : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.description || undefined,
  dateCreated: String(data.year),
  creator: { '@type': 'Person', name: site.name },
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={data.title} description={data.description || `${data.title}, by ${site.name}.`} image={data.image} type="article" jsonLd={jsonLd} back>
  <article class="page">
    <header class="sp head">
      <h1 class="sp-scene">{data.title} ({data.year})</h1>
      {data.role && <p class="muted">{data.role}</p>}
      {data.description && <p>{data.description}</p>}
      {
        fullScript && (
          <p>
            <a href={fullScript.href} {...(fullScript.external ? { rel: 'noopener', target: '_blank' } : {})}>
              {fullScript.label}
            </a>
          </p>
        )
      }
    </header>

    {
      (data.image || thumbnail) && (
        <div class="frame">
          {video ? (
            <button type="button" class="hit" data-video={video.embed} data-title={data.title} aria-label={`Play ${data.title}`}>
              {data.image ? (
                <Image src={data.image} alt={data.imageAlt ?? ''} widths={[720, 1080, 1440]} sizes="(min-width: 42rem) 38rem, 100vw" />
              ) : (
                <img src={thumbnail} alt={data.imageAlt ?? ''} />
              )}
              <span class="play" aria-hidden="true">▶ Play</span>
            </button>
          ) : (
            data.image && <Image src={data.image} alt={data.imageAlt ?? ''} widths={[720, 1080, 1440]} sizes="(min-width: 42rem) 38rem, 100vw" />
          )}
        </div>
      )
    }

    <section class="script" aria-label={label.heading ?? 'Script'}>
      {label.heading && <p class="label muted">{label.heading}</p>}
      <Excerpt elements={elements} owner={site.name} title={data.title} year={data.year} />
    </section>
  </article>

  {video && <Theatre />}
</Base>

<style>
  .head {
    padding-block: 2lh;
  }

  .head > * + * {
    margin-top: 0.5lh;
  }

  .frame {
    position: relative;
    margin-bottom: 3lh;
    background: var(--line);
  }

  .frame :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .hit {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .play {
    position: absolute;
    left: 1ch;
    bottom: 0.5lh;
    padding: 0.15lh 1ch;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.875em;
    text-transform: uppercase;
  }

  .script {
    padding-top: 2lh;
    border-top: 1px solid var(--line);
  }

  .label {
    margin-bottom: 2lh;
    font-size: 0.8125em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
