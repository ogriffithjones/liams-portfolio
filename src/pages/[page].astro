---
// Top-level pages: custom pages from the CMS, plus the writing page, each at
// the address set in Settings.
import type { GetStaticPaths } from 'astro';
import CustomPage from '../components/pages/CustomPage.astro';
import WritingIndex from '../components/pages/WritingIndex.astro';
import { getWriting } from '../lib/content';
import { getPages, getPaths } from '../lib/paths';

export const getStaticPaths = (async () => {
  const paths = await getPaths();
  const pages = await getPages();
  return [
    ...pages.map((page) => ({ params: { page: page.id }, props: { kind: 'page' as const, page } })),
    ...((await getWriting()).length ? [{ params: { page: paths.writing }, props: { kind: 'writing' as const } }] : []),
  ];
}) satisfies GetStaticPaths;

const props = Astro.props;
---

{props.kind === 'page' && <CustomPage page={props.page} />}
{props.kind === 'writing' && <WritingIndex />}
