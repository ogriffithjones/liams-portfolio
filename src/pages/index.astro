---
import Base from '../layouts/Base.astro';
import Title from '../components/Title.astro';
import Blocks from '../components/Blocks.astro';
import { getEntry } from 'astro:content';
import { getSite, getWork } from '../lib/content';

const site = await getSite();
const work = await getWork();
const home = (await getEntry('home', 'index'))?.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role || undefined,
  url: Astro.site?.href,
  email: site.email ? `mailto:${site.email}` : undefined,
  address: site.location || undefined,
  sameAs: site.links.map((l) => l.url),
};
---

<Base image={work.find((w) => w.data.image)?.data.image} jsonLd={jsonLd}>
  <Title />
  {home && <Blocks blocks={home.blocks} ending={home.ending} />}
</Base>
