---
// One page per piece of writing, film list and project with a script, under
// each section's address from Settings (e.g. /writing/my-piece).
import type { GetStaticPaths } from 'astro';
import WritingPage from '../../components/pages/WritingPage.astro';
import ListPage from '../../components/pages/ListPage.astro';
import WorkPage from '../../components/pages/WorkPage.astro';
import { getLists, getWork, getWriting } from '../../lib/content';
import { getPaths } from '../../lib/paths';
import { hasExcerpt } from '../../lib/screenplay';

export const getStaticPaths = (async () => {
  const paths = await getPaths();
  return [
    ...(await getWriting()).map((piece) => ({
      params: { base: paths.writing, slug: piece.id },
      props: { kind: 'writing' as const, piece },
    })),
    ...(await getLists()).map((list) => ({ params: { base: paths.lists, slug: list.id }, props: { kind: 'list' as const, list } })),
    ...(await getWork())
      .filter((w) => hasExcerpt(w.data))
      .map((project) => ({ params: { base: paths.work, slug: project.id }, props: { kind: 'work' as const, project } })),
  ];
}) satisfies GetStaticPaths;

const props = Astro.props;
---

{props.kind === 'writing' && <WritingPage piece={props.piece} />}
{props.kind === 'list' && <ListPage list={props.list} />}
{props.kind === 'work' && <WorkPage project={props.project} />}
