---
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getSite } from '../lib/content';
import { tmdbEnabled } from '../lib/tmdb';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | null;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Show the "back to home" header (used on note pages). */
  back?: boolean;
}

const site = await getSite();
const { title, description = site.seoDescription ?? '', image, type = 'website', jsonLd, back = false } = Astro.props;

const homeTitle = site.role ? `${site.name}, ${site.role}` : site.name;
const fullTitle = title ? `${title} | ${site.name}` : homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <!-- No AI training or text and data mining (see /ai.txt, /.well-known/tdmrep.json) -->
    <meta name="robots" content="noai, noimageai" />
    <meta name="tdm-reservation" content="1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
    <Font cssVariable="--font-script" preload={[{ weight: 400, style: 'normal' }, { weight: 700, style: 'normal' }]} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {
      back && (
        <header class="page top">
          <a href="/">← {site.name}</a>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>

    <footer class="page foot muted">
      <p>© {new Date().getFullYear()} {site.name}. All rights reserved. No AI training or text and data mining.</p>
      {tmdbEnabled && <p>Film posters from <a href="https://www.themoviedb.org/" rel="noopener" target="_blank">TMDB</a>. This site uses the TMDB API but is not endorsed or certified by TMDB.</p>}
    </footer>
  </body>
</html>

<style>
  .top {
    padding-block: 2rem;
  }

  .top a {
    text-decoration: none;
    text-transform: uppercase;
  }

  .foot {
    padding-block: 4lh 2lh;
  }

  .foot p {
    font-size: 0.8125em;
  }

  .foot p + p {
    margin-top: 0.5lh;
  }
</style>
