---
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getSite } from '../lib/content';
import { tmdbEnabled } from '../lib/tmdb';
import { themeColours, themeCss } from '../lib/themes';
import Halftone from '../components/Halftone.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | null;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Show the "back to home" header (used on note pages). */
  back?: boolean;
}

const site = await getSite();
const { title, description = site.seoDescription ?? '', image, type = 'website', jsonLd, back = false } = Astro.props;

const homeTitle = site.role ? `${site.name}, ${site.role}` : site.name;
const fullTitle = title ? `${title} | ${site.name}` : homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : null;
const ogUrl = og ? new URL(og.src, Astro.site).href : null;
const { theme } = site;
const barColour = themeColours(theme);
---

<!doctype html>
<html lang="en" data-default-mode={theme.mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <!-- No AI training or text and data mining (see /ai.txt, /.well-known/tdmrep.json) -->
    <meta name="robots" content="noai, noimageai" />
    <meta name="tdm-reservation" content="1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {barColour.light && <meta name="theme-color" content={barColour.light} media="(prefers-color-scheme: light)" />}
    {barColour.dark && <meta name="theme-color" content={barColour.dark} media="(prefers-color-scheme: dark)" />}
    <style is:inline set:html={themeCss(theme)}></style>
    {
      theme.lightsSwitch && (
        <script is:inline>
          try {
            const mode = localStorage.getItem('lights');
            if (mode === 'light' || mode === 'dark') document.documentElement.dataset.mode = mode;
          } catch {}
        </script>
      )
    }
    <Font cssVariable="--font-script" preload={[{ weight: 400, style: 'normal' }, { weight: 700, style: 'normal' }]} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {theme.dots.discriminant === 'on' && <Halftone {...theme.dots.value} />}
    {
      site.nav.show ? (
        <Nav />
      ) : (
        back && (
          <header class="page top">
            <a href="/">← {site.name}</a>
          </header>
        )
      )
    }

    <main id="main">
      <slot />
    </main>

    <footer class="page foot muted">
      <div class="main">
        <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
        {theme.lightsSwitch && <button type="button" class="lights" data-lights>Lights off</button>}
      </div>
      <p class="fine">
        No AI training or text and data mining.
        {
          tmdbEnabled && (
            <>
              {' '}
              Film posters from{' '}
              <a href="https://www.themoviedb.org/" rel="noopener" target="_blank">
                TMDB
              </a>
              . This product uses the TMDB API but is not endorsed or certified by TMDB.
            </>
          )
        }
      </p>
    </footer>

    {
      theme.lightsSwitch && (
        <script is:inline>
          (() => {
            const html = document.documentElement;
            const button = document.querySelector('[data-lights]');
            const current = () =>
              html.dataset.mode ||
              (html.dataset.defaultMode === 'auto'
                ? matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
                : html.dataset.defaultMode);
            const label = () => (button.textContent = current() === 'dark' ? 'Lights on' : 'Lights off');
            button.addEventListener('click', () => {
              html.dataset.mode = current() === 'dark' ? 'light' : 'dark';
              try { localStorage.setItem('lights', html.dataset.mode); } catch {}
              label();
            });
            matchMedia('(prefers-color-scheme: dark)').addEventListener('change', label);
            label();
          })();
        </script>
      )
    }
  </body>
</html>

<style>
  .top {
    padding-block: 2rem;
  }

  .top a {
    text-decoration: none;
    text-transform: uppercase;
  }

  .foot {
    margin-top: 4lh;
    padding-block: 1.5lh 2lh;
    border-top: 1px solid var(--line);
    font-size: 0.8125em;
  }

  /* Copyright on the left, the lights switch on the right */
  .main {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5lh 2ch;
  }

  /* Small print: AI opt-out and the TMDB credit their terms require */
  .fine {
    margin-top: 0.75lh;
    font-size: 0.875em;
    line-height: 1.5;
    opacity: 0.85;
  }

  .fine a {
    color: inherit;
  }

  .lights {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--accent, currentColor);
    cursor: pointer;
  }
</style>
