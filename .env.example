# Canonical site URL (set once a custom domain is attached)
SITE_URL=https://example.com

# Keystatic GitHub mode. Leave unset locally to edit files directly.
PUBLIC_KEYSTATIC_GITHUB_REPO=owner/liams-portfolio
# Generated by the Keystatic GitHub App setup (see README)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
